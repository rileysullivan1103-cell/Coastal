# Copy to .env and fill in. .env is gitignored — never commit real tokens.
#
# WebCOOS: register at https://app.webcoos.org/u/accounts/login/ then copy the
# token from your profile page. Sent as "Authorization: Token <value>".
WEBCOOS_TOKEN=

# NOAA CDO: request at https://www.ncdc.noaa.gov/cdo-web/token (emailed to you).
# Sent as the "token" header. Limits: 5 req/sec, 10000 req/day.
NOAA_CDO_TOKEN=
